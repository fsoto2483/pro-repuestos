{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "repuestospro-prod",
          "appId": "1:943040419024:android:780a9366f1f292209f7ad5",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "repuestospro-prod",
          "configurations": {
            "android": "1:943040419024:android:780a9366f1f292209f7ad5",
            "web": "1:943040419024:web:de24c97126c2ebf79f7ad5",
            "windows": "1:943040419024:web:61fdc27ef96a550d9f7ad5"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/catalogo/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "!/catalogo/**",
        "destination": "/index.html"
      }
    ]
  }
}
