rules_version = '2';
service cloud.firestore {
  // ===============================================================
  // Assumed Data Model
  // ===============================================================
  //
  // Collection: users
  // Document ID: Firebase Auth uid
  // Fields:
  //   - uid, nombre, email, provider, role, status (required on create)
  //   - photoUrl, workshopName, city, workshop (optional)
  //   - createdAt, updatedAt (timestamps)
  //
  // Catalog: products, brands, categories, vehicleMakes,
  //          vehicleModels, engines — read if active; write if admin.
  // quotes — create/read if active (owner or admin).
  // ===============================================================

  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return exists(userDocPath());
    }

    function userDoc() {
      return get(userDocPath()).data;
    }

    // Legacy sin `status` cuenta como active.
    function isActive() {
      return isAuthenticated()
        && hasUserDoc()
        && userDoc().get('status', 'active') == 'active';
    }

    function isAdmin() {
      return isActive() && userDoc().role == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidRole(value) {
      return value in ['admin', 'client'];
    }

    function isValidStatus(value) {
      return value in ['active', 'suspended'];
    }

    function isValidProvider(value) {
      return value in ['password', 'google'];
    }

    function hasOnlyAllowedUserFields() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'nombre',
        'email',
        'photoUrl',
        'provider',
        'role',
        'status',
        'workshopName',
        'city',
        'workshop',
        'createdAt',
        'updatedAt'
      ]);
    }

    // Objeto opcional users/{uid}.workshop (Datos del Taller).
    function isValidWorkshop(value) {
      return value is map
        && value.keys().hasOnly([
          'razonSocial',
          'nombreComercial',
          'ruc',
          'propietario',
          'telefono',
          'whatsapp',
          'correo',
          'direccion',
          'referencia',
          'departamento',
          'provincia',
          'distrito',
          'lat',
          'lng',
          'updatedAt'
        ])
        && value.get('razonSocial', '') is string
        && value.get('razonSocial', '').size() <= 200
        && value.get('nombreComercial', '') is string
        && value.get('nombreComercial', '').size() <= 200
        && value.get('ruc', '') is string
        && value.get('ruc', '').size() <= 32
        && value.get('propietario', '') is string
        && value.get('propietario', '').size() <= 120
        && value.get('telefono', '') is string
        && value.get('telefono', '').size() <= 40
        && value.get('whatsapp', '') is string
        && value.get('whatsapp', '').size() <= 40
        && value.get('correo', '') is string
        && value.get('correo', '').size() <= 254
        && value.get('direccion', '') is string
        && value.get('direccion', '').size() <= 300
        && value.get('referencia', '') is string
        && value.get('referencia', '').size() <= 300
        && value.get('departamento', '') is string
        && value.get('departamento', '').size() <= 120
        && value.get('provincia', '') is string
        && value.get('provincia', '').size() <= 120
        && value.get('distrito', '') is string
        && value.get('distrito', '').size() <= 120
        && (value.get('lat', null) == null || value.lat is number)
        && (value.get('lng', null) == null || value.lng is number)
        && (
          !('updatedAt' in value)
          || value.updatedAt is timestamp
        );
    }

    function isValidUserShape(data, userId) {
      return hasOnlyAllowedUserFields()
        && data.uid == userId
        && data.nombre is string
        && data.nombre.size() > 0
        && data.nombre.size() <= 120
        && data.email is string
        && data.email.size() > 2
        && data.email.size() <= 254
        && isValidProvider(data.provider)
        && isValidRole(data.role)
        && data.get('status', 'active') in ['active', 'suspended']
        && data.createdAt is timestamp
        && (!('workshop' in data) || isValidWorkshop(data.workshop));
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    function statusUnchanged() {
      return request.resource.data.get('status', 'active')
        == resource.data.get('status', 'active');
    }

    function uidUnchanged() {
      return request.resource.data.uid == resource.data.uid;
    }

    function createdAtUnchanged() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    // Dueño: solo escribe workshop (+ updatedAt). No toca role/status.
    function isOwnerWorkshopUpdate(userId) {
      return isOwner(userId)
        && roleUnchanged()
        && statusUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['workshop', 'updatedAt'])
        && 'workshop' in request.resource.data
        && isValidWorkshop(request.resource.data.workshop);
    }

    // Migracion legacy: doc sin role ni status. El dueño puede agregar
    // UNA sola vez role=client y status=active (sin auto-promocion).
    function isLegacyRoleStatusBackfill() {
      return !('role' in resource.data)
        && !('status' in resource.data)
        && request.resource.data.role == 'client'
        && request.resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'status', 'updatedAt']);
    }

    match /users/{userId} {
      // get: dueño (aunque suspended o sin doc aun) o admin activo.
      // list: solo admin activo (UsersAdminScreen).
      allow get: if isOwner(userId)
        || (
          isAuthenticated()
          && exists(userDocPath())
          && get(userDocPath()).data.role == 'admin'
          && get(userDocPath()).data.get('status', 'active') == 'active'
        );

      allow list: if isAdmin();

      // Alta en el primer login/registro.
      allow create: if isOwner(userId)
        && isValidUserShape(request.resource.data, userId)
        && request.resource.data.role == 'client'
        && request.resource.data.status == 'active';

      // Dueño: perfil sin cambiar role/status (ya fijados).
      // Dueño: update de workshop (Datos del Taller).
      // Dueño legacy: backfill unico role=client + status=active.
      // Admin activo: puede cambiar role y status.
      allow update: if uidUnchanged()
        && createdAtUnchanged()
        && (
          (
            isOwner(userId)
            && isValidUserShape(request.resource.data, userId)
            && roleUnchanged()
            && statusUnchanged()
          )
          || isOwnerWorkshopUpdate(userId)
          || (
            isOwner(userId)
            && isLegacyRoleStatusBackfill()
            && isValidUserShape(request.resource.data, userId)
          )
          || (
            isAdmin()
            && isValidUserShape(request.resource.data, userId)
          )
        );

      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /vehicleMakes/{makeId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /vehicleModels/{modelId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /engines/{engineId} {
      allow read: if isActive();
      allow create, update, delete: if isAdmin();
    }

    match /quotes/{quoteId} {
      // Dueño lee las suyas; admin lee todas.
      allow read: if isAuthenticated() && hasUserDoc() && (
        (isActive() && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow create: if isActive()
        && request.resource.data.keys().hasAll([
          'userId',
          'quoteNumber',
          'customerName',
          'items',
          'subtotal',
          'igv',
          'total',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.quoteNumber is string
        && request.resource.data.items is list;
      allow update, delete: if isActive() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
    }
  }
}
